# ==========================================
# PROJECTOR SETTINGS
# ==========================================

# The network IP address of the physical projector unit
PROJECTOR_IP=192.168.138.xxx

# The standard network port for the PJLink protocol (default is 4352)
PROJECTOR_PORT=4352

# The authentication password required to send commands via PJLink
PJLINK_PASSWORD=your_password_here

# The local port used by the service to listen for incoming commands from the backend server
LISTEN_PORT=5050


# ==========================================
# SERVER SETTINGS
# ==========================================

# The IP address of the backend server
SERVER_IP=192.168.137.xxx

# The standard HTTP port used for web communication
SERVER_PORT=80


# ==========================================
# ZONE CONFIGURATION SETTINGS
# ==========================================

# The local port used by the service to listen for incoming commands from the backend server
ZONE_CONFIG_PORT=5051


# ==========================================
# DETECTION (AI) SETTINGS
# ==========================================

# Minimum confidence score (0.0 to 1.0) for the AI to register a detection
# A value of 0.2 means the AI must be at least 20% confident in its detection for it to be considered valid
CONFIDENCE_THRESHOLD=0.2

# Intersection over Union (IoU) threshold to handle overlapping detection boxes
# Helps prevent multiple detections for the same object
# A value of 0.2 means that if two detection boxes overlap by more than 20%, they will be considered the same object and only one will be kept
IOU_THRESHOLD=0.2